{
  "manifest_version": 3,
  "name": "OneClick Cancel — Subscription Manager MVP",
  "version": "0.1.0",
  "description": "Cancela assinaturas de Netflix e Spotify com um clique, usando a sessão local já autenticada do usuário.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "OneClick Cancel"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "tabs",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://www.netflix.com/*",
    "https://account.spotify.com/*",
    "https://www.spotify.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.netflix.com/*"],
      "js": ["content-scripts/engine.js", "content-scripts/netflix.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.spotify.com/*", "https://account.spotify.com/*"],
      "js": ["content-scripts/spotify.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
